{
  "name": "aitri",
  "version": "2.2.0-rc.7",
  "description": "Aitri — the harness that makes agentic engineering rigorous: a gated, spec-driven SDLC for AI agents. Works with Claude Code, Codex, Gemini, Opencode.",
  "bin": {
    "aitri": "bin/aitri.js"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "C\u00e9sar Augusto Reyes Serrano",
  "license": "Apache-2.0",
  "files": [
    "bin",
    "lib",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "test:smoke": "node --test test/smoke.js",
    "test:all": "node --test 'test/**/*.test.js' test/smoke.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-lines=90 --test-coverage-branches=80 'test/**/*.test.js'"
  },
  "dependencies": {}
}
